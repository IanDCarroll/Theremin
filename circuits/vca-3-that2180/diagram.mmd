flowchart TD
  PWR(("Power Supply Positive"))
  GND(("Ground"))
  AUDIOIN(("Pitch Audio Input"))
  CVIN(("Volume Control Voltage Input"))
  AUDIOOUT(("Scaled Audio Output"))

  subgraph BIAS["Virtual Ground"]
    VREF_IC{{"Virtual Ground IC (TLE2426)"}}

    PWR ---|"Input (IN)"| VREF_IC
    VREF_IC ---|"Common (COMMON)"| GND
  end

  subgraph VCA["Voltage-Controlled Amplifier and Current-to-Voltage Stage"]
    VCA_IC{{"VCA IC (THAT 2180), 8-pin SIP"}}
    OPAMP{{"Dual Op Amp IC (TL072), one amplifier used"}}
    INPUT_COUPLE["Input Coupling Capacitor, ~10 µF"]
    INPUT_R["Input Resistor, ~20 kΩ"]
    FEEDBACK_R["Feedback Resistor, ~20 kΩ"]
    FEEDBACK_CAP["Feedback Capacitor, ~22 pF"]
    SET_R["Bias Set Resistor, ~1.3 kΩ"]
    CONTROL_R_UPPER["Control Divider Resistor (Upper), ~110 kΩ"]
    CONTROL_R_LOWER["Control Divider Resistor (Lower), ~10 kΩ"]
    OUTPUT_COUPLE["Output Coupling Capacitor, ~10 µF"]

    AUDIOIN --- INPUT_COUPLE
    INPUT_COUPLE --- INPUT_R
    INPUT_R ---|"Pin 1 (Input)"| VCA_IC
    VCA_IC ---|"Pin 8 (Output) / Pin 2 (1IN−)"| OPAMP
    OPAMP ---|"Pin 1 (1OUT)"| FEEDBACK_R
    FEEDBACK_R ---|"Pin 2 (1IN−)"| OPAMP
    OPAMP ---|"Pin 1 (1OUT)"| FEEDBACK_CAP
    FEEDBACK_CAP ---|"Pin 2 (1IN−)"| OPAMP
    OPAMP ---|"Pin 1 (1OUT)"| OUTPUT_COUPLE
    OUTPUT_COUPLE --- AUDIOOUT
    VREF_IC ---|"Output (OUT) / Pin 3 (1IN+)"| OPAMP
    OPAMP ---|"Pin 8 (VCC+)"| PWR
    OPAMP ---|"Pin 4 (VCC−)"| GND
    VCA_IC ---|"Pin 7 (V+)"| PWR
    VCA_IC ---|"Pin 5 (V−)"| SET_R
    SET_R --- GND
    VREF_IC ---|"Output (OUT) / Pin 3 (Ec−) and Pin 6 (Gnd)"| VCA_IC
    CVIN --- CONTROL_R_UPPER
    CONTROL_R_UPPER ---|"Pin 2 (Ec+)"| VCA_IC
    VCA_IC ---|"Pin 2 (Ec+)"| CONTROL_R_LOWER
    CONTROL_R_LOWER ---|"Output (OUT)"| VREF_IC
  end
