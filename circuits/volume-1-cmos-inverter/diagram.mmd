flowchart TD
  PWR(("Power Supply Positive"))
  GND(("Ground"))
  ANTENNA(("Volume Antenna"))
  VOLUMEOUT(("Volume Control Voltage Output"))

  subgraph OSC["Volume Oscillator, mirrors Design 1"]
    IC{{"Hex Inverter IC (CD4069UB), one gate used"}}
    FEEDBACK_R["Feedback Resistor, ~470 kΩ"]
    TIMING_CAP["Timing Capacitor, ~100 pF, baseline"]
    IC ---|"Output (Inverter Gate)"| FEEDBACK_R
    FEEDBACK_R ---|"Input (Inverter Gate)"| IC
    IC ---|"Input (Inverter Gate)"| TIMING_CAP
    TIMING_CAP --- GND
    IC ---|"Input (Inverter Gate)"| ANTENNA
    IC ---|"Positive Supply (VDD)"| PWR
    IC ---|"Ground (VSS)"| GND
  end

  subgraph F2V["Frequency-to-Voltage Converter and Control Voltage Conditioning"]
    F2V_IC{{"Frequency-to-Voltage IC (LM2907-N, 8-pin)"}}
    F2V_INPUT_COUPLE["Input Coupling Capacitor, ~330 nF"]
    F2V_INPUT_R["Input Bias Resistor, ~100 kΩ"]
    F2V_TIMING_CAP["Pump Timing Capacitor, ~1 nF"]
    F2V_OUTPUT_R["Pump Output Resistor, ~47 kΩ"]
    F2V_RIPPLE_CAP["Ripple Filter Capacitor, ~1 µF"]
    F2V_LOAD_R["Emitter Load Resistor, ~10 kΩ"]
    COND_FEEDBACK_R["Gain Feedback Resistor, ~100 kΩ"]
    COND_GAIN_R["Gain Resistor, ~3.3 kΩ"]
    COND_FLOOR_TRIM["Floor Trimmer, ~10 kΩ"]

    IC ---|"Output (Inverter Gate)"| F2V_INPUT_COUPLE
    F2V_INPUT_COUPLE ---|"Pin 1 (TACH+)"| F2V_IC
    F2V_IC ---|"Pin 1 (TACH+)"| F2V_INPUT_R
    F2V_INPUT_R --- GND
    F2V_IC ---|"Pin 8 (TACH−/GND)"| GND
    F2V_IC ---|"Pin 2 (CP1)"| F2V_TIMING_CAP
    F2V_TIMING_CAP --- GND
    F2V_IC ---|"Pin 3 (CP2/IN+)"| F2V_OUTPUT_R
    F2V_OUTPUT_R --- GND
    F2V_IC ---|"Pin 3 (CP2/IN+)"| F2V_RIPPLE_CAP
    F2V_RIPPLE_CAP --- GND
    F2V_IC ---|"Pin 5 (COL) and Pin 6 (V+)"| PWR
    F2V_IC ---|"Pin 4 (EMIT)"| F2V_LOAD_R
    F2V_LOAD_R --- GND
    F2V_IC ---|"Pin 4 (EMIT)"| COND_FEEDBACK_R
    COND_FEEDBACK_R ---|"Pin 7 (IN−)"| F2V_IC
    F2V_IC ---|"Pin 7 (IN−)"| COND_GAIN_R
    COND_GAIN_R ---|"Wiper"| COND_FLOOR_TRIM
    COND_FLOOR_TRIM ---|"End (Supply Side)"| PWR
    COND_FLOOR_TRIM ---|"End (Ground Side)"| GND
    F2V_IC ---|"Pin 4 (EMIT)"| VOLUMEOUT
  end
